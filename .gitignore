# Build output and the virtualenv are reproducible from source - never commit them.
.venv/
build/
__pycache__/
*.pyc
# assets/icon64.png is regenerated by tools/make_icon.py; the .ico is kept because the build needs it.
assets/icon64.png

# Release installers are attached to GitHub Releases, not committed - they are build output.
dist-releases/

# Android/Capacitor wrapper. The native project in mobile/android is committed so the build is
# reproducible, but its build output, dependencies and machine-specific SDK path are not.
mobile/node_modules/
mobile/www/index.html
mobile/android/build/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/capacitor-cordova-android-plugins/
mobile/android/app/src/main/assets/public/
mobile/android/app/src/main/assets/capacitor.config.json

# ── Not part of the program ───────────────────────────────────────────────────────────────────────
# This repository is PUBLIC. Anything not listed here is published the moment it is committed, so
# working material stays on disk only.

# Private notes and plans. Put new ones in notes/ and they are ignored automatically.
notes/

# Design working material: conversation exports and delivery archives.
# _archive/ is listed because it HAS been committed before - a whole design-tool export, support.js
# and all, plus a second copy of the game. It is still readable in this repo's public history; this
# only stops it happening again.
*.dc.html
*.zip
_archive/
.thumbnail

# Design sources and screen recordings. None of these have leaked yet - they are here so that
# dropping one in the project folder cannot quietly publish it.
*.psd
*.ai
*.fig
*.sketch
*.mp4
*.mov

# Local working copy of the old traffic-cone icon art. Nothing in the build uses it any more - the
# app icon is assets/gt-impact.ico (Batch 547), and the exported cone files left the repo in Batch 556.
cone ico files/

# Signing keys never go in a public repository. The Android release key lives in
# %USERPROFILE%\.keystores\, outside this folder entirely; these patterns are only a backstop in
# case one is ever copied in here by mistake.
*.jks
*.keystore
*.p12
*signing.properties

# Kept on disk, not published (direct decision, Batch 556): the design brief and the agent rules.
docs/
AGENTS.md

# Editors and operating systems leaving things behind
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
*~
*.tmp
*.bak
*.log
